.vercel
.env
.env.local
.env*.local
supabase/.temp/

# NOTE: js/config.js is intentionally tracked. Its Google and NREL keys are
# client-side by design and restricted by HTTP referrer / free tier. It was
# previously listed here, which had no effect (the file was already tracked)
# and implied a protection that did not exist.
node_modules/

# Seeded design-canvas output (~2MB build artifact; re-seeded from the .dc.html sources)
design/**/balco-home-page-directions.html
design/**/nyc.geojson
design/**/preview-*.png
design/**/city.svg.frag
design/**/__pycache__/
design/**/shot-*.png
design/red-fork/fork-*.png

# Fork build outputs (~950KB each, mostly inlined three.js; rebuild with build_fork.py)
design/red-fork/balco-red-fork.html
design/red-fork/find-the-sun-on-your-block.html

# Design-canvas working output: the seeded page is ~3MB and is rebuilt from
# the artboards by seed-canvas.mjs. The geometry JSON is a Chromium capture
# rebuilt by design/hero-responsive/extract.py.
design/hero-responsive/balcony-hero-responsive.html
design/hero-responsive/hero-geometry.json
design/hero-responsive/build/
