// ============================================================
// balco.nyc Solar Calculator: API Configuration (example)
// ============================================================
// js/config.js is committed: this is a static site with no build step, so
// the client-side keys ship to the browser by design (see the notes there).
// Use this file as the template for a fork or a local copy with your own
// keys; every modelling constant should be copied from js/config.js, which
// is the single source of truth (explained in docs/modeling-decisions.md).
// ============================================================

const SolarConfig = {
  // Google Maps JavaScript API: restrict to your domain in Google Cloud Console
  GOOGLE_API_KEY: 'YOUR_GOOGLE_API_KEY',

  // NREL/NLR API key: free, client-safe, get from https://developer.nlr.gov/signup/
  NREL_API_KEY: 'YOUR_NREL_API_KEY',

  // NYC Socrata app token — optional, increases rate limits
  SOCRATA_APP_TOKEN: '',

  // Endpoints (NREL is now NLR; nrel.gov no longer resolves)
  GEOCLIENT_PROXY_URL: '/api/geoclient',
  PVWATTS_URL: 'https://developer.nlr.gov/api/pvwatts/v8.json',
  PLUTO_URL: 'https://data.cityofnewyork.us/resource/64uk-42ks.json',
  FOOTPRINTS_URL: 'https://data.cityofnewyork.us/resource/5zhs-2jue.geojson',
  TREES_URL: 'https://data.cityofnewyork.us/resource/hn5i-inap.json',

  // Everything below must match js/config.js. Copy the whole block from there
  // rather than editing values here.
};
